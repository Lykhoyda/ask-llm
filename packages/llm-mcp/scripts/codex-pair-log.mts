#!/usr/bin/env node
// Source of truth: codex-pair-log.mts. The sibling .mjs is generated by `yarn workspace @ask-llm/mcp build:hooks`; never edit it.

// CLI viewer for the .codex-pair/log.jsonl the hook writes; run with --help for subcommands.

import { readFileSync } from "node:fs";
import { access } from "node:fs/promises";
import { homedir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { parseFrontmatter } from "./lib/frontmatter.mts";
import { loadPairDefaults } from "./lib/pair-config-io.mts";
import { resolveBlockOn, resolveConfig } from "./lib/pair-config.mts";
import { type PairLogEntry as LogEntry, buildReport, formatReport } from "./lib/pair-report.mts";
import { formatSetup, setupFailed, setupMarker } from "./lib/pair-setup.mts";
import {
  CONTEXT_FILENAME,
  PAIR_ROOT_DIR,
  addAck,
  contextPath,
  pauseManually,
  readAcks,
  readPauseInfo,
  logPath as resolveLogPath,
  resumeManually,
} from "./lib/state.mts";
import { canonicalFile, readBlockingHighs } from "./lib/stop-gate-io.mts";

interface Args {
  cmd: "latest" | "summary" | "file" | "help" | "status" | "report" | "ack" | "pause" | "resume" | "setup";
  json: boolean;
  hash: string | null;
  n: number;
  file: string | null;
  sinceMs: number | null;
}

const MARKER_FILE = join(PAIR_ROOT_DIR, CONTEXT_FILENAME);

async function findMarkerUp(startDir: string): Promise<string | null> {
  const home = homedir();
  let current = resolve(startDir);
  for (let depth = 0; depth < 20; depth++) {
    const candidate = join(current, MARKER_FILE);
    try {
      await access(candidate);
      return current;
    } catch {
      // not found here
    }
    const parent = dirname(current);
    if (parent === current) return null;
    if (current === home) return null;
    current = parent;
  }
  return null;
}

function parseDuration(s: string): number | null {
  const m = s.match(/^(\d+)([smhd])$/);
  if (!m) return null;
  const n = Number(m[1]);
  const unit = m[2];
  if (unit === "s") return n * 1000;
  if (unit === "m") return n * 60 * 1000;
  if (unit === "h") return n * 60 * 60 * 1000;
  if (unit === "d") return n * 24 * 60 * 60 * 1000;
  return null;
}

function parseArgs(argv: string[]): Args {
  const args: Args = { cmd: "latest", n: 10, file: null, sinceMs: null, json: false, hash: null };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--latest") {
      args.cmd = "latest";
      const next = argv[i + 1];
      if (next && /^\d+$/.test(next)) {
        args.n = Number(next);
        i++;
      }
    } else if (a === "--status") {
      args.cmd = "status";
    } else if (a === "--report") {
      args.cmd = "report";
    } else if (a === "--json") {
      args.json = true;
    } else if (i === 0 && a === "ack") {
      args.cmd = "ack";
      args.hash = argv[++i] ?? null;
    } else if (i === 0 && (a === "pause" || a === "resume" || a === "setup")) {
      args.cmd = a;
    } else if (a === "--summary") {
      args.cmd = "summary";
    } else if (a === "--file") {
      args.cmd = "file";
      args.file = argv[i + 1] ?? null;
      i++;
    } else if (a === "--since") {
      const next = argv[i + 1];
      const ms = next ? parseDuration(next) : null;
      if (ms === null) {
        process.stderr.write(`codex-pair-log: invalid --since duration "${next ?? ""}"\n`);
        process.exit(2);
      }
      args.sinceMs = ms;
      i++;
    } else if (a === "--help" || a === "-h") {
      args.cmd = "help";
    } else {
      process.stderr.write(`codex-pair-log: unknown arg "${a}"\n`);
      process.exit(2);
    }
  }
  if (args.json && args.cmd !== "report") {
    process.stderr.write("codex-pair-log: --json requires --report\n");
    process.exit(2);
  }
  if (args.cmd === "ack" && !/^[0-9a-f]{16}$/.test(args.hash ?? "")) {
    process.stderr.write("codex-pair-log: ack requires a 16-character lowercase hex hash\n");
    process.exit(2);
  }
  return args;
}

function readLog(logPath: string): string {
  try {
    return readFileSync(logPath, "utf8");
  } catch {
    return "";
  }
}

function loadEntries(content: string): LogEntry[] {
  const entries: LogEntry[] = [];
  for (const line of content.split("\n")) {
    if (line.length === 0) continue;
    try {
      const entry = JSON.parse(line);
      if (entry && typeof entry === "object" && !Array.isArray(entry)) entries.push(entry);
    } catch {
      // skip malformed lines silently
    }
  }
  return entries;
}

function applySinceFilter(entries: LogEntry[], sinceMs: number | null): LogEntry[] {
  if (sinceMs == null) return entries;
  const cutoff = Date.now() - sinceMs;
  return entries.filter((e) => {
    if (!e.timestamp) return false;
    const t = new Date(e.timestamp).getTime();
    return Number.isFinite(t) && t >= cutoff;
  });
}

function formatCounts(entry: LogEntry): string {
  if (entry.counts) {
    return `${entry.counts.high}H/${entry.counts.med}M/${entry.counts.low}L`;
  }
  return "—";
}

function formatDuration(ms: number | null | undefined): string {
  if (ms == null) return "—";
  if (ms < 1000) return `${ms}ms`;
  return `${(ms / 1000).toFixed(1)}s`;
}

function showLatest(entries: LogEntry[], n: number): void {
  const slice = entries.slice(-n);
  for (const e of slice) {
    const verdict = (e.verdict || (e.level ? `[${e.level}]` : "?")).padEnd(13);
    const file = (e.file || "—").padEnd(50);
    const counts = formatCounts(e).padEnd(11);
    const dur = formatDuration(e.durationMs);
    const ts = e.timestamp || "—";
    process.stdout.write(`${ts}  ${verdict} ${file} ${counts} ${dur}\n`);
  }
}

// Match any path to the same file; the hook logs canonical paths, older entries may hold aliases.
function showFile(entries: LogEntry[], filePath: string): void {
  const target = canonicalFile(filePath);
  const filtered = entries.filter((e) => typeof e.file === "string" && canonicalFile(e.file) === target);
  if (filtered.length === 0) {
    process.stdout.write(`codex-pair-log: no entries for file ${filePath}\n`);
    return;
  }
  showLatest(filtered, filtered.length);
}

function showSummary(entries: LogEntry[]): void {
  const verdictCounts: Record<string, number> = {};
  const fileCounts: Record<string, number> = {};
  let durationSum = 0;
  let durationCount = 0;
  let fallbackCount = 0;
  let cachedCount = 0;
  let runCount = 0;
  for (const e of entries) {
    if (e.verdict) {
      verdictCounts[e.verdict] = (verdictCounts[e.verdict] || 0) + 1;
    }
    if (e.file) {
      fileCounts[e.file] = (fileCounts[e.file] || 0) + 1;
    }
    if (e.fellBack && e.verdict !== "cached") fallbackCount++;
    if (e.verdict === "cached") cachedCount++;
    if (e.verdict === "none" || e.verdict === "concerns" || e.verdict === "cached") {
      runCount++;
    }
    if (e.durationMs != null && (e.verdict === "none" || e.verdict === "concerns")) {
      durationSum += e.durationMs;
      durationCount++;
    }
  }
  const topFiles = Object.entries(fileCounts)
    .sort((a, b) => b[1] - a[1])
    .slice(0, 5);
  process.stdout.write(`codex-pair log summary\n`);
  process.stdout.write(`Total entries:    ${entries.length}\n`);
  process.stdout.write(`Verdict breakdown:\n`);
  for (const [v, c] of Object.entries(verdictCounts).sort((a, b) => b[1] - a[1])) {
    process.stdout.write(`  ${v.padEnd(15)} ${c}\n`);
  }
  process.stdout.write(`Top 5 files by entry count:\n`);
  for (const [f, c] of topFiles) {
    process.stdout.write(`  ${String(c).padStart(4)}  ${f}\n`);
  }
  if (durationCount > 0) {
    const avg = durationSum / durationCount;
    process.stdout.write(
      `Average codex duration (uncached runs only): ${formatDuration(avg)} over ${durationCount} runs\n`,
    );
  }
  if (runCount > 0) {
    const cacheRate = ((cachedCount / runCount) * 100).toFixed(1);
    process.stdout.write(`Cache hit rate: ${cachedCount} / ${runCount} (${cacheRate}%)\n`);
  }
  if (fallbackCount > 0) {
    process.stdout.write(`Fallback model used: ${fallbackCount} time(s)\n`);
  }
}

// Read-only: observing a pause never clears it or starts a reviewer/broker.
function showStatus(markerDir: string, entries: LogEntry[]): void {
  const marker = readFileSync(contextPath(markerDir), "utf8");
  const parsed = parseFrontmatter(marker);
  let config: ReturnType<typeof resolveConfig> | undefined;
  let refusal: string | undefined;
  try {
    config = resolveConfig(parsed.frontmatter, process.env, loadPairDefaults(), marker);
  } catch (error) {
    refusal = error instanceof Error ? error.message : String(error);
  }
  const pause = readPauseInfo(markerDir);
  const state =
    process.env.CODEX_PAIR_DISABLED === "1"
      ? "disabled (CODEX_PAIR_DISABLED=1)"
      : pause
        ? `paused (${pause.manual ? "manual" : pause.kind})`
        : refusal
          ? `disabled (${refusal})`
          : "active";
  process.stdout.write(
    [
      `codex-pair status — ${markerDir}`,
      `State: ${state}`,
      ...(config
        ? [
            `Reviewer: ${config.reviewer}`,
            `Model: ${config.model}`,
            `Fallback model: ${config.reviewer === "codex" ? config.fallbackModel : "not used (Claude reviewer)"}`,
            `Reasoning effort: ${config.reviewer === "codex" ? config.reasoningEffort : "not used (Claude reviewer)"}`,
            `Guards turn end on: ${config.blockOn ?? "nothing"}`,
            `Surface threshold: ${config.surfaceThreshold}`,
            `Timeout: ${config.timeoutMs}ms`,
            `Max file bytes: ${config.maxFileBytes}`,
            `Debounce: ${config.debounceMs}ms (max ${config.debounceMaxMs}ms)`,
          ]
        : []),
      ...(parsed.malformed ? ["Warning: malformed frontmatter; using environment/defaults."] : []),
      ...(pause?.at ? [`Paused since: ${pause.at}`] : []),
      ...(pause?.reason ? [`Pause reason: ${pause.reason}`] : []),
      ...(pause?.resetHint ? [`Resets ~ ${pause.resetHint}`] : []),
      "Recent reviews (last 5):",
      "",
    ].join("\n"),
  );
  const recent = entries.filter((entry) => entry.verdict !== "paused" && entry.verdict !== "resumed");
  if (recent.length === 0) process.stdout.write("No reviews recorded.\n");
  else showLatest(recent, 5);
  const failure = entries.findLast((e) =>
    ["error", "spawn_failed", "timeout", "unparsed", "parse_failed"].includes(e.verdict ?? ""),
  );
  if (failure?.reason) process.stdout.write(`Recent failure: ${failure.reason}\n`);
}

function showHelp(): void {
  process.stdout.write(
    [
      "codex-pair-log — view .codex-pair/log.jsonl written by the codex-pair hook",
      "",
      "Usage: codex-pair-log [SUBCOMMAND] [--since DURATION]",
      "",
      "Subcommands:",
      "  --latest [N]      Show last N entries (default 10). Default subcommand.",
      "  --status         Show resolved configuration, state and last five reviews.",
      "  --summary         Aggregate stats over the log.",
      "  --report [--json] Report reviews, findings, acknowledgements, current HIGH blockers and pauses.",
      "  ack <hash>        Record an acknowledgement with the reason read from stdin.",
      "  pause             Pause this project's hook and record the event.",
      "  resume            Resume this project's hook, clear failures and record the event.",
      "  setup             Copy .codex-pair.example/context.md to the marker when absent; ignore .codex-pair/ locally.",
      "  --file <path>     Filter to one file's history.",
      "  --since <dur>     Filter to entries within the last <dur>. Examples: 30m, 24h, 7d.",
      "  --help, -h        Show this help.",
      "",
    ].join("\n"),
  );
}

async function main(): Promise<void> {
  const args = parseArgs(process.argv.slice(2));
  if (args.cmd === "help") {
    showHelp();
    return;
  }
  if (args.cmd === "setup") {
    const outcome = setupMarker(process.cwd());
    process.stdout.write(`${formatSetup(outcome)}\n`);
    if (setupFailed(outcome)) process.exit(1);
    return;
  }
  const markerDir = await findMarkerUp(process.cwd());
  if (!markerDir) {
    process.stderr.write(`codex-pair-log: no .codex-pair/context.md marker found in cwd or parents\n`);
    process.exit(1);
  }
  if (args.cmd === "ack" && args.hash) {
    const reason = readFileSync(0, "utf8").trim();
    if (!reason) {
      process.stderr.write("codex-pair-log: ack requires a non-empty reason on stdin\n");
      process.exit(2);
    }
    addAck(markerDir, args.hash, { reason });
    process.stdout.write(`codex-pair: acknowledged ${args.hash}\n`);
    return;
  }
  if (args.cmd === "pause") {
    const paused = await pauseManually(markerDir);
    process.stdout.write(`codex-pair ${paused ? "paused" : "already paused"} for ${markerDir}\n`);
    return;
  }
  if (args.cmd === "resume") {
    const pause = await resumeManually(markerDir);
    if (!pause) {
      process.stdout.write(`codex-pair was not paused for ${markerDir}\n`);
      return;
    }
    if (pause.kind) {
      const detail = [pause.reason, pause.resetHint && `resets ~${pause.resetHint}`].filter(Boolean).join(", ");
      process.stdout.write(`Previous auto-pause (${pause.kind})${detail ? ` — ${detail}` : ""}\n`);
    }
    process.stdout.write(`codex-pair resumed for ${markerDir}. Reviews resume on the next supported edit.\n`);
    return;
  }
  const logPath = resolveLogPath(markerDir);
  const log = readLog(logPath);
  let entries = loadEntries(log);
  if (args.cmd === "report") {
    const canonical = canonicalFile(markerDir);
    const cutoff = args.sinceMs === null ? null : Date.now() - args.sinceMs;
    if (cutoff !== null && !Number.isFinite(new Date(cutoff).getTime())) {
      process.stderr.write("codex-pair-log: --since duration is out of range\n");
      process.exit(2);
    }
    const acks = readAcks(canonical);
    const marker = readFileSync(contextPath(canonical), "utf8");
    const blocking = resolveBlockOn(marker) === "HIGH" ? readBlockingHighs(canonical, log, acks) : [];
    const report = buildReport(canonical, entries, acks, blocking, cutoff);
    process.stdout.write(`${args.json ? JSON.stringify(report, null, 2) : formatReport(report)}\n`);
    return;
  }
  if (args.cmd === "status") {
    showStatus(markerDir, applySinceFilter(entries, args.sinceMs));
    return;
  }
  if (entries.length === 0) {
    process.stdout.write(`codex-pair-log: no entries in ${logPath}\n`);
    return;
  }
  entries = applySinceFilter(entries, args.sinceMs);
  if (args.cmd === "latest") {
    showLatest(entries, args.n);
  } else if (args.cmd === "summary") {
    showSummary(entries);
  } else if (args.cmd === "file") {
    if (!args.file) {
      process.stderr.write(`codex-pair-log: --file requires a path argument\n`);
      process.exit(2);
    }
    showFile(entries, args.file);
  }
}

main().catch((err) => {
  process.stderr.write(`codex-pair-log: ${err?.message ?? String(err)}\n`);
  process.exit(1);
});
