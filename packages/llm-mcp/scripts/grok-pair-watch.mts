#!/usr/bin/env node
// Source of truth: grok-pair-watch.mts. The sibling .mjs is generated by `yarn workspace @ask-llm/mcp build:hooks`; never edit it.

import { spawn } from "node:child_process";
import { fileURLToPath } from "node:url";
import { adaptGrokPayload } from "./lib/grok-payload.mts";

async function main(): Promise<void> {
  let raw = "";
  for await (const chunk of process.stdin) raw += chunk;
  const payload = adaptGrokPayload(JSON.parse(raw), process.cwd());
  if (!payload) return;
  const child = spawn(process.execPath, [fileURLToPath(new URL("./codex-pair-watch.mjs", import.meta.url))], {
    stdio: ["pipe", "inherit", "inherit"],
    env: { ...process.env, CODEX_PAIR_HOST: "grok" },
  });
  child.stdin.on("error", () => {});
  child.stdin.end(JSON.stringify(payload));
  child.on("error", (error) => {
    process.stderr.write(`codex-pair Grok adapter: ${error.message}\n`);
  });
}

main().catch((error) => {
  process.stderr.write(`codex-pair Grok adapter: ${error.message}\n`);
});
