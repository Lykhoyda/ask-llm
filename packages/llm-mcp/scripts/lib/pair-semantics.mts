// Source of truth: pair-semantics.mts. The sibling .mjs is generated by `yarn workspace @ask-llm/mcp build:hooks`; never edit it.

import type { ReviewAttribution } from "./state.mts";

export type Reviewer = "codex" | "claude";
export type WriterFamily = Reviewer | "grok" | "unknown";

export const CLAUDE_PAIR_MODEL = "claude-opus-5-5";

export function resolveReviewer(setting: unknown, writerFamily: WriterFamily): Reviewer {
  const reviewer = setting ?? "codex";
  if (reviewer !== "codex" && reviewer !== "claude") {
    throw new Error("codex-pair refused: reviewer must be codex or claude");
  }
  if (reviewer === writerFamily) {
    throw new Error(
      `codex-pair refused: ${reviewer} cannot review its own model family's edits (${writerFamily} writer)`,
    );
  }
  return reviewer;
}

export function reviewCacheModel(reviewer: Reviewer, model: string): string {
  return reviewer === "claude" ? `claude:${model}` : model;
}

export function isCachedReviewCompatible(attribution: Partial<ReviewAttribution>, fallbackModel: string): boolean {
  return !attribution.fellBack || attribution.model === fallbackModel;
}

export function reviewAttribution(
  config: { reviewer: Reviewer; model: string; fallbackModel: string; reasoningEffort: string },
  fellBack: boolean,
): ReviewAttribution {
  return {
    reviewer: config.reviewer,
    model: fellBack ? config.fallbackModel : config.model,
    // The Claude adapter does not set or observe an effort tier.
    reasoningEffort: config.reviewer === "codex" ? config.reasoningEffort : "unknown",
    fellBack,
  };
}
