import { isAbsolute, resolve } from "node:path";
import type { HookInput } from "./hook-input.mjs";

export function adaptGrokPayload(raw: unknown, cwd: string): HookInput | null {
  if (!raw || typeof raw !== "object") return null;
  const payload = raw as Record<string, unknown>;
  if (payload.hook_event_name !== "PostToolUse" || payload.toolInputTruncated === true) return null;
  const input = payload.tool_input;
  if (!input || typeof input !== "object") return null;
  const fields = input as Record<string, unknown>;
  const eventCwd = typeof payload.cwd === "string" && isAbsolute(payload.cwd) ? payload.cwd : cwd;
  const session_id = typeof payload.session_id === "string" ? payload.session_id : undefined;
  if (payload.tool_name === "search_replace" && typeof fields.file_path === "string" && fields.file_path) {
    return {
      hook_event_name: "PostToolUse",
      session_id,
      tool_name: "Edit",
      tool_input: { file_path: resolve(eventCwd, fields.file_path) },
    };
  }
  if (payload.tool_name === "run_terminal_command" && typeof fields.command === "string" && fields.command) {
    return {
      hook_event_name: "PostToolUse",
      session_id,
      tool_name: "Bash",
      tool_input: { command: fields.command, cwd: eventCwd },
    };
  }
  return null;
}
