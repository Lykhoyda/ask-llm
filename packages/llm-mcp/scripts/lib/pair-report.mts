// Source of truth: pair-report.mts. The sibling .mjs is generated by `yarn workspace @ask-llm/mcp build:hooks`; never edit it.

import { basename, relative, resolve } from "node:path";
import { hashConcernBody } from "./state.mts";
import { canonicalFile } from "./stop-gate-io.mts";
import type { BlockingHigh, LogEntry } from "./stop-gate.mts";

const SEVERITIES = ["high", "med", "low"] as const;
type Severity = (typeof SEVERITIES)[number];

export interface PairLogEntry extends Pick<LogEntry, "concerns" | "concernHashes"> {
  timestamp?: string;
  verdict?: string;
  level?: string;
  file?: string;
  tool?: string;
  source?: string;
  coverage?: string;
  counts?: Record<Severity, number>;
  durationMs?: number;
  reviewer?: string;
  model?: string;
  reasoningEffort?: string;
  fellBack?: boolean;
  reason?: string;
  event?: "pause" | "resume";
  pauseKind?: string;
  pauseStartedAt?: string;
  autoPaused?: string;
}

interface Finding {
  hash: string;
  file: string;
  severity: Severity;
}

interface PauseWindow {
  kind: string;
  startedAt: string;
  endedAt: string;
}

function pauseWindows(entries: PairLogEntry[], cutoff: number | null): PauseWindow[] {
  const events = entries
    .filter(
      (entry) =>
        entry.event === "pause" || entry.event === "resume" || entry.autoPaused || entry.verdict === "auto_resumed",
    )
    .sort((a, b) => (Date.parse(a.timestamp ?? "") || 0) - (Date.parse(b.timestamp ?? "") || 0));
  const windows: PauseWindow[] = [];
  let open: PauseWindow | undefined;
  for (const entry of events) {
    const at = entry.timestamp ?? "unknown";
    const kind = entry.pauseKind ?? entry.autoPaused ?? "unknown";
    if (entry.event === "pause" || entry.autoPaused) {
      // A new pause proves the previous sentinel was cleared, but gives no resume time.
      if (open) open.endedAt = "unknown";
      open = { kind, startedAt: at, endedAt: "open" };
      windows.push(open);
    } else {
      if (open && (kind === "unknown" || open.kind === kind)) {
        open.endedAt = at;
        open = undefined;
      } else {
        windows.push({ kind, startedAt: entry.pauseStartedAt ?? "unknown", endedAt: at });
      }
    }
  }
  return windows.filter(
    (window) =>
      cutoff === null ||
      window.endedAt === "open" ||
      Date.parse(window.endedAt) >= cutoff ||
      (window.endedAt === "unknown" && Date.parse(window.startedAt) >= cutoff),
  );
}

function entryFindings(entry: PairLogEntry, file: string): Finding[] {
  return SEVERITIES.flatMap((severity) => {
    const hashes = entry.concernHashes?.[severity] ?? [];
    const texts = entry.concerns?.[severity] ?? [];
    return Array.from({ length: Math.max(hashes.length, texts.length) }, (_, index) => ({
      hash: hashes[index] ?? hashConcernBody(`${file}:${texts[index]}`),
      file,
      severity,
    }));
  });
}

function acknowledgementReason(ack: unknown): string {
  if (ack && typeof ack === "object" && "reason" in ack && typeof ack.reason === "string") return ack.reason;
  return typeof ack === "string" ? ack : "unknown";
}

export function buildReport(
  markerDir: string,
  entries: PairLogEntry[],
  acks: Record<string, unknown>,
  blocking: BlockingHigh[],
  cutoff: number | null,
) {
  // Pi shares the file but has its own lifecycle and finding format.
  const hookEntries = entries.filter((entry) => entry.source !== "pi");
  let reviewsRun = 0;
  let cachedHits = 0;
  let fallbackReviews = 0;
  const models = new Map<
    string,
    { reviewer: string; model: string; reasoningEffort: string; reviewsRun: number; cachedHits: number }
  >();
  const findings = new Map<string, { finding: Finding; repeats: number }>();
  const latestByFile = new Map<string, { complete: boolean; hashes: Set<string> }>();
  const paths = new Map<string, string>();

  for (const entry of hookEntries) {
    const cached = entry.verdict === "cached";
    if (!cached && entry.verdict !== "none" && entry.verdict !== "concerns") continue;

    const inWindow = cutoff === null || Date.parse(entry.timestamp ?? "") >= cutoff;
    if (inWindow) {
      if (cached) cachedHits++;
      else reviewsRun++;
      if (!cached && entry.fellBack) fallbackReviews++;

      const reviewer = entry.reviewer ?? "unknown";
      const reasoningEffort = entry.reasoningEffort ?? "unknown";
      // Old Grok fallback rows stored the primary request model, not the one that ran.
      const model = entry.fellBack && !entry.reasoningEffort ? "unknown" : (entry.model ?? "unknown");
      const key = JSON.stringify([reviewer, model, reasoningEffort]);
      const modelStats = models.get(key) ?? { reviewer, model, reasoningEffort, reviewsRun: 0, cachedHits: 0 };
      if (cached) modelStats.cachedHits++;
      else modelStats.reviewsRun++;
      models.set(key, modelStats);
    }
    if (!entry.file) continue;
    let file = paths.get(entry.file);
    if (file === undefined) {
      file = relative(markerDir, canonicalFile(resolve(markerDir, entry.file)));
      paths.set(entry.file, file);
    }
    const observed = entryFindings(entry, file);
    const hashes = new Set(observed.map((finding) => finding.hash));
    if (entry.coverage !== "command-text" && !(entry.tool === "Bash" && basename(file) === "[shell command]")) {
      // Legacy rows may record a verdict or counts without the actual findings.
      const complete =
        entry.verdict === "none" ||
        SEVERITIES.every((severity) => {
          const length = Math.max(
            entry.concernHashes?.[severity]?.length ?? 0,
            entry.concerns?.[severity]?.length ?? 0,
          );
          const count = entry.counts?.[severity];
          return count === undefined
            ? entry.concerns?.[severity] !== undefined || entry.concernHashes?.[severity] !== undefined
            : length === count;
        });
      latestByFile.set(file, { complete, hashes });
    }
    if (!inWindow) continue;

    // A hash can appear twice in one review, or be reclassified. Count one observation per review.
    const seen = new Set<string>();
    for (const finding of observed) {
      const prior = findings.get(finding.hash);
      if (!prior) findings.set(finding.hash, { finding, repeats: 0 });
      else {
        if (!seen.has(finding.hash)) prior.repeats++;
        if (SEVERITIES.indexOf(finding.severity) < SEVERITIES.indexOf(prior.finding.severity)) prior.finding = finding;
      }
      seen.add(finding.hash);
    }
  }

  const blockingByHash = new Map(
    blocking.map(({ file, hash }) => [hash, { file: relative(markerDir, file), hash, severity: "high" as const }]),
  );
  const findingsBySeverity = { high: 0, med: 0, low: 0 };
  const repeatedFindings: (Finding & { repeats: number })[] = [];
  const acknowledgedFindings: (Finding & { reason: string })[] = [];
  const otherUnacknowledgedHighs: Finding[] = [];
  const noLongerReported: Finding[] = [];
  for (const { finding, repeats } of findings.values()) {
    const { hash, severity, file } = finding;
    findingsBySeverity[severity]++;
    if (repeats) repeatedFindings.push({ ...finding, repeats });
    if (acks[hash]) acknowledgedFindings.push({ ...finding, reason: acknowledgementReason(acks[hash]) });
    else if (severity === "high" && !blockingByHash.has(hash)) otherUnacknowledgedHighs.push(finding);
    const latest = latestByFile.get(file);
    if (latest?.complete && !latest.hashes.has(hash)) noLongerReported.push(finding);
  }

  return {
    repository: basename(markerDir),
    since: cutoff === null ? null : new Date(cutoff).toISOString(),
    reviewsRun,
    cachedHits,
    fallbackReviews,
    findingsBySeverity,
    repeatedFindings,
    acknowledgedFindings,
    blockingHighs: [...blockingByHash.values()],
    otherUnacknowledgedHighs,
    noLongerReported,
    models: [...models.values()],
    pauseWindows: pauseWindows(hookEntries, cutoff),
  };
}

const findingLabel = ({ severity, hash, file }: Finding): string =>
  `${severity.toUpperCase()} [${hash}] ${JSON.stringify(file)}`;

export function formatReport(report: ReturnType<typeof buildReport>): string {
  const {
    repository,
    since,
    reviewsRun,
    cachedHits,
    fallbackReviews,
    findingsBySeverity,
    repeatedFindings,
    acknowledgedFindings,
    blockingHighs,
    otherUnacknowledgedHighs,
    noLongerReported,
    models,
    pauseWindows,
  } = report;
  const { high, med, low } = findingsBySeverity;
  const repeats = repeatedFindings.reduce((sum, finding) => sum + finding.repeats, 0);
  const modelStats = models
    .map(
      ({ reviewer, model, reasoningEffort, reviewsRun, cachedHits }) =>
        `${reviewer}/${model}/${reasoningEffort} (${reviewsRun} run, ${cachedHits} cached)`,
    )
    .join(", ");
  const heading = [
    `codex-pair ${repository} (${since ? `since ${since}` : "retained log"})`,
    `reviews run ${reviewsRun}, cache hits ${cachedHits}, fallback reviews ${fallbackReviews}`,
    `${high} HIGH / ${med} MED / ${low} LOW unique, repeats ${repeats}`,
    `${acknowledgedFindings.length} acknowledged`,
    `${blockingHighs.length} HIGH blocking now, ${otherUnacknowledgedHighs.length} other unacknowledged HIGH`,
    `${noLongerReported.length} findings no longer reported on the latest review of their file`,
    `pause windows ${pauseWindows.length}`,
    modelStats || "reviewer/model/effort unknown",
  ].join(" | ");
  return [
    heading,
    ...repeatedFindings.map((finding) => `Repeated ${findingLabel(finding)} ×${finding.repeats}`),
    ...acknowledgedFindings.map(
      (finding) => `Acknowledged ${findingLabel(finding)} — ${JSON.stringify(finding.reason)}`,
    ),
    ...blockingHighs.map((finding) => `Blocking now ${findingLabel(finding)}`),
    ...otherUnacknowledgedHighs.map((finding) => `Other unacknowledged ${findingLabel(finding)}`),
    ...noLongerReported.map(
      (finding) => `Finding no longer reported on the latest review of its file — ${findingLabel(finding)}`,
    ),
    ...pauseWindows.map(({ kind, startedAt, endedAt }) => `Pause ${kind} ${startedAt} → ${endedAt}`),
  ].join("\n");
}
