import { readFileSync } from "node:fs";
import { INLINE_PAIR_DEFAULTS, type PairDefaults } from "./pair-config.mts";

export function loadPairDefaults(): PairDefaults {
  try {
    return JSON.parse(readFileSync(new URL("../../codex-pair-defaults.json", import.meta.url), "utf8"));
  } catch {
    return INLINE_PAIR_DEFAULTS;
  }
}
