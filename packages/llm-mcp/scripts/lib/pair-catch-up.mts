// Source of truth: pair-catch-up.mts. The sibling .mjs is generated by `yarn workspace @ask-llm/mcp build:hooks`; never edit it.

import { spawn } from "node:child_process";
import { fileURLToPath } from "node:url";
import { dirtyCoverage, reviewPending } from "./pair-coverage.mts";
import { collectSessionMarkers } from "./session-registry.mts";
import { INFLIGHT_TTL_MIN_MS, readPauseInfo, releaseInflightLock, tryAcquireInflightLock } from "./state.mts";

const MAX_FILES = 10;
const PASS_BUDGET_MS = 120_000;
const WORKER_PATH = fileURLToPath(new URL("../codex-pair-debounce-worker.mjs", import.meta.url));

export interface CatchUpTarget {
  markerDir: string;
  file: string;
  timeoutMs: number;
}

export interface CatchUpPass {
  targets: CatchUpTarget[];
  activeMarkers: string[];
  firstLock: string;
  deadline: number;
}

export function lockCatchUpTarget({ markerDir, file, timeoutMs }: CatchUpTarget): string | undefined {
  if (reviewPending(markerDir, file, timeoutMs)) return;
  const lock = tryAcquireInflightLock(markerDir, file, Math.max(timeoutMs, INFLIGHT_TTL_MIN_MS) + 60_000);
  if (lock.acquired) return lock.lockPath;
}

export function startCatchUp(markerDir: string | null, sessionId: string | undefined, atStop = false): boolean {
  if (process.env.CODEX_PAIR_DISABLED === "1") return false;
  const deadline = Date.now() + PASS_BUDGET_MS;
  const activeMarkers = collectSessionMarkers(markerDir, sessionId).filter((marker) => !readPauseInfo(marker));
  const targets: CatchUpTarget[] = [];
  let firstLock: string | undefined;

  try {
    scan: for (const marker of activeMarkers) {
      for (const { status, ...target } of dirtyCoverage(marker, { atStop, deadline })) {
        if (status === "reviewed" || status === "pending") continue;
        targets.push(target);
        if (targets.length === MAX_FILES) break scan;
      }
      if (Date.now() >= deadline) return false;
    }

    while (!firstLock && targets.length > 0 && Date.now() < deadline) {
      // Reserve the first file before returning so Stop can see it in its existing in-flight check.
      firstLock = lockCatchUpTarget(targets[0]);
      if (!firstLock) targets.shift();
    }
    if (!firstLock) return false;

    const pass: CatchUpPass = { targets, activeMarkers, firstLock, deadline };
    const worker = spawn(process.execPath, [WORKER_PATH], {
      detached: true,
      stdio: "ignore",
      env: { ...process.env, CP_CATCH_UP_PASS: JSON.stringify(pass), CP_SESSION_ID: sessionId ?? "" },
    });
    worker.on("error", () => releaseInflightLock(firstLock));
    worker.unref();
    return true;
  } catch {
    releaseInflightLock(firstLock);
    return false;
  }
}
