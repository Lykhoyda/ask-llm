// Source of truth: pair-setup.mts. The sibling .mjs is generated by `yarn workspace @ask-llm/mcp build:hooks`; never edit it.

// Question-free marker setup for /codex-pair: copy a committed template and keep the marker out of git
// through the repository's local exclude file. An existing marker is never overwritten.

import { execFileSync } from "node:child_process";
import { appendFileSync, copyFileSync, constants, lstatSync, mkdirSync, readFileSync, realpathSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import { CONTEXT_FILENAME, PAIR_ROOT_DIR } from "./state.mts";

export const TEMPLATE_DIR = ".codex-pair.example";
const EXCLUDE_LINE = `${PAIR_ROOT_DIR}/`;

export type IgnoreOutcome =
  | { kind: "excluded"; excludeFile: string }
  | { kind: "already-ignored" }
  | { kind: "failed"; reason: string };

export type SetupOutcome =
  | { kind: "not-git"; reason: string }
  | { kind: "no-template"; root: string; template: string }
  | { kind: "invalid-template"; root: string; template: string }
  | { kind: "invalid-marker"; root: string; marker: string }
  | { kind: "ignore-failed"; reason: string }
  | {
      kind: "created";
      root: string;
      marker: string;
      template: string;
      ignore: Exclude<IgnoreOutcome, { kind: "failed" }>;
    }
  | { kind: "exists"; root: string; marker: string; ignore: IgnoreOutcome };

function git(cwd: string, args: string[]): string {
  return execFileSync("git", ["-C", cwd, ...args], {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
    timeout: 5000,
  }).trim();
}

function exists(path: string): boolean {
  try {
    lstatSync(path);
    return true;
  } catch {
    return false;
  }
}

function isLocalFilePath(root: string, path: string): boolean {
  let current = path;
  while (current !== root) {
    if (exists(current)) {
      const stat = lstatSync(current);
      if (!(current === path ? stat.isFile() : stat.isDirectory()) || realpathSync(current) !== current) return false;
    }
    const parent = dirname(current);
    if (parent === current) return false;
    current = parent;
  }
  return true;
}

// A linked worktree's .git is a file, so ask git where the exclude file lives instead of joining paths.
export function excludeFilePath(root: string): string {
  return resolve(root, git(root, ["rev-parse", "--git-path", "info/exclude"]));
}

function ignoredByGit(root: string, directory: string): boolean {
  try {
    git(root, ["check-ignore", "-q", directory]);
    return true;
  } catch (err) {
    // Exit 1 means "not ignored"; anything else is a real git failure.
    if ((err as { status?: number }).status === 1) return false;
    throw err;
  }
}

export function pairDirectoryIgnored(markerDir: string): boolean | null {
  let root: string;
  try {
    root = git(markerDir, ["rev-parse", "--show-toplevel"]);
  } catch {
    return null;
  }
  return ignoredByGit(root, `${join(markerDir, PAIR_ROOT_DIR)}/`);
}

export function ensureExcluded(root: string, marker: string): IgnoreOutcome {
  try {
    if (!isLocalFilePath(root, marker)) return { kind: "failed", reason: `${marker} is not a local regular file path` };
    const directory = `${dirname(marker)}/`;
    if (ignoredByGit(root, directory)) return { kind: "already-ignored" };
    const excludeFile = excludeFilePath(root);
    let current = "";
    try {
      current = readFileSync(excludeFile, "utf8");
    } catch {
      mkdirSync(dirname(excludeFile), { recursive: true });
    }
    const separator = current.length > 0 && !current.endsWith("\n") ? "\n" : "";
    appendFileSync(excludeFile, `${separator}${EXCLUDE_LINE}\n`);
    if (!ignoredByGit(root, directory)) return { kind: "failed", reason: `${directory} is still not ignored by git` };
    return { kind: "excluded", excludeFile };
  } catch (err) {
    return { kind: "failed", reason: (err as Error)?.message ?? String(err) };
  }
}

export function setupMarker(cwd: string): SetupOutcome {
  let root: string;
  try {
    root = realpathSync(git(cwd, ["rev-parse", "--show-toplevel"]));
  } catch (err) {
    return { kind: "not-git", reason: (err as Error)?.message ?? String(err) };
  }
  let directory = resolve(root, git(cwd, ["rev-parse", "--show-prefix"]));
  while (true) {
    const marker = join(directory, PAIR_ROOT_DIR, CONTEXT_FILENAME);
    if (!isLocalFilePath(root, marker)) return { kind: "invalid-marker", root, marker };
    if (exists(marker)) return { kind: "exists", root, marker, ignore: ensureExcluded(root, marker) };
    if (directory === root) break;
    directory = dirname(directory);
  }
  const template = join(root, TEMPLATE_DIR, CONTEXT_FILENAME);
  if (!exists(template)) return { kind: "no-template", root, template };
  if (!isLocalFilePath(root, template)) return { kind: "invalid-template", root, template };
  const marker = join(root, PAIR_ROOT_DIR, CONTEXT_FILENAME);
  const ignore = ensureExcluded(root, marker);
  if (ignore.kind === "failed") return { kind: "ignore-failed", reason: ignore.reason };
  mkdirSync(dirname(marker), { recursive: true });
  try {
    copyFileSync(template, marker, constants.COPYFILE_EXCL);
  } catch (err) {
    if ((err as NodeJS.ErrnoException)?.code !== "EEXIST") throw err;
    return { kind: "exists", root, marker, ignore: ensureExcluded(root, marker) };
  }
  return { kind: "created", root, marker, template, ignore };
}

function describeIgnore(ignore: IgnoreOutcome): string {
  if (ignore.kind === "excluded") return `codex-pair: ${PAIR_ROOT_DIR}/ is ignored through ${ignore.excludeFile}`;
  if (ignore.kind === "already-ignored") return `codex-pair: ${PAIR_ROOT_DIR}/ is already ignored by git`;
  return `codex-pair: could not add ${PAIR_ROOT_DIR}/ to git's local exclude file: ${ignore.reason}`;
}

export function setupFailed(outcome: SetupOutcome): boolean {
  if (outcome.kind === "invalid-template" || outcome.kind === "invalid-marker" || outcome.kind === "ignore-failed")
    return true;
  return outcome.kind === "exists" && outcome.ignore.kind === "failed";
}

// The first word of the first line is the outcome the skill branches on.
export function formatSetup(outcome: SetupOutcome): string {
  switch (outcome.kind) {
    case "not-git":
      return `not-git: not inside a git repository; draft ${PAIR_ROOT_DIR}/${CONTEXT_FILENAME} interactively in the current directory. Nothing is added to git ignore rules.`;
    case "no-template":
      return [
        `no-template: ${outcome.template} does not exist; draft ${PAIR_ROOT_DIR}/${CONTEXT_FILENAME} interactively in the current directory.`,
        `Then run setup again from the same directory to keep ${PAIR_ROOT_DIR}/ out of git.`,
      ].join("\n");
    case "invalid-template":
      return `invalid-template: ${outcome.template} must be a regular file inside the repository without symlinked components; nothing was copied.`;
    case "invalid-marker":
      return `invalid-marker: ${outcome.marker} must be a regular file path inside the repository without symlinked components; nothing was changed.`;
    case "ignore-failed":
      return `ignore-failed: ${outcome.reason}; no marker was created.`;
    case "created":
      return [`created: copied ${outcome.template} to ${outcome.marker}`, describeIgnore(outcome.ignore)].join("\n");
    case "exists":
      return [`exists: ${outcome.marker} already exists and was left unchanged`, describeIgnore(outcome.ignore)].join(
        "\n",
      );
  }
}
