// Source of truth: pair-coverage.mts. The sibling .mjs is generated by `yarn workspace @ask-llm/mcp build:hooks`; never edit it.

import { existsSync, lstatSync, readFileSync, statSync } from "node:fs";
import { dirname, join, relative, resolve, sep } from "node:path";
import { contentHash, fileContentHash, readEditRecord } from "./debounce-state.mts";
import { parseFrontmatter } from "./frontmatter.mts";
import { loadPairDefaults } from "./pair-config-io.mts";
import { resolveConfig } from "./pair-config.mts";
import { readFileScope } from "./pair-file-scope.mts";
import { contextPath, INFLIGHT_TTL_MIN_MS, inflightLockPath, logPath, PAIR_ROOT_DIR } from "./state.mts";
import { canonicalFile, gitDirtySet } from "./stop-gate-io.mts";
import { collectInFlight, type LogEntry, selectReviewEntries } from "./stop-gate.mts";

const SUCCESS = new Set(["none", "concerns", "cached"]);
const FAILURE = new Set(["error", "timeout", "spawn_failed", "parse_failed", "unparsed"]);

export type Coverage = "reviewed" | "pending" | "failed" | "not-started";

export function reviewContextHash(body: string, config: ReturnType<typeof resolveConfig>): string {
  const { reviewer, model, fallbackModel, reasoningEffort, maxFileBytes } = config;
  return contentHash(JSON.stringify([body, reviewer, model, fallbackModel, reasoningEffort, maxFileBytes]));
}

function readReviews(markerDir: string) {
  try {
    return selectReviewEntries(readFileSync(logPath(markerDir), "utf8"), (file) =>
      canonicalFile(resolve(markerDir, file)),
    );
  } catch {
    return new Map<string, LogEntry[]>();
  }
}

function matchesReviewContent(entry: LogEntry, hash: string): boolean {
  return entry.contentHash === hash && entry.coverage !== "command-text" && entry.tool !== "Bash";
}

function currentEntry(entry: LogEntry, contextHash: string, markerMtime: number): boolean {
  if (typeof entry.reviewContextHash === "string") {
    return entry.reviewContextHash === contextHash && entry.markerMtime === markerMtime;
  }
  // Older logs carry attribution and timing, but no fingerprint of the context shown to the reviewer.
  const finished = typeof entry.timestamp === "string" ? Date.parse(entry.timestamp) : NaN;
  const duration = typeof entry.durationMs === "number" ? entry.durationMs : 0;
  return finished - duration >= Math.floor(markerMtime);
}

function isReviewed(
  entries: LogEntry[],
  hash: string,
  contextHash: string,
  markerMtime: number,
  config: ReturnType<typeof resolveConfig>,
): boolean {
  return entries.some((entry) => {
    if (!entry.verdict || !SUCCESS.has(entry.verdict) || !matchesReviewContent(entry, hash)) return false;
    if (!currentEntry(entry, contextHash, markerMtime)) return false;
    if (entry.reviewContextHash === contextHash) return true;
    // A legacy fallback identifies the model that ran, but cannot prove the primary model requested.
    return (
      !entry.fellBack &&
      entry.reviewer === config.reviewer &&
      entry.model === config.model &&
      (config.reviewer === "claude" || entry.reasoningEffort === config.reasoningEffort)
    );
  });
}

export function hasCurrentReview(
  markerDir: string,
  file: string,
  hash: string,
  contextHash: string,
  markerMtime: number,
  config: ReturnType<typeof resolveConfig>,
): boolean {
  return isReviewed(readReviews(markerDir).get(canonicalFile(file)) ?? [], hash, contextHash, markerMtime, config);
}

export function reviewPending(markerDir: string, file: string, timeoutMs: number): boolean {
  const record = readEditRecord(markerDir, file);
  const lockMtimes = [];
  try {
    lockMtimes.push(statSync(inflightLockPath(markerDir, file)).mtimeMs);
  } catch {
    // There may be a settling generation without a lock.
  }
  return collectInFlight({
    records: record ? [record] : [],
    lockMtimes,
    now: Date.now(),
    freshMs: Math.max(timeoutMs, INFLIGHT_TTL_MIN_MS) + 60_000,
  }).any;
}

// A catch-up pass stays in known repositories and never follows a symlink or descends into another marker.
export function isCatchUpFile(markerDir: string, file: string): boolean {
  if (file.split(sep).includes(PAIR_ROOT_DIR)) return false;
  try {
    if (!lstatSync(file).isFile()) return false;
    const canonical = canonicalFile(markerDir);
    if (canonicalFile(file) !== resolve(canonical, relative(markerDir, file))) return false;
    for (let parent = dirname(file); parent !== markerDir; parent = dirname(parent)) {
      if (existsSync(contextPath(parent))) return false;
      if (dirname(parent) === parent) break;
    }
    return true;
  } catch {
    return false; // The path may have been deleted or replaced during the scan.
  }
}

export function* dirtyCoverage(markerDir: string, { atStop = false, deadline = Infinity } = {}) {
  const markerPath = contextPath(markerDir);
  let marker: string;
  let markerMtime: number;
  let config: ReturnType<typeof resolveConfig>;
  let contextHash: string;
  try {
    markerMtime = statSync(markerPath).mtimeMs;
    marker = readFileSync(markerPath, "utf8");
    const { frontmatter, body } = parseFrontmatter(marker);
    if (atStop && frontmatter.catchUpOnStop === false) return;
    config = resolveConfig(frontmatter, process.env, loadPairDefaults(), marker);
    contextHash = reviewContextHash(body, config);
  } catch {
    return;
  }

  const dirty = gitDirtySet(markerDir, deadline);
  if (!dirty?.size) return;
  const reviews = readReviews(markerDir);
  const scope = readFileScope(markerDir);
  const canonical = canonicalFile(markerDir);
  for (const path of dirty) {
    if (Date.now() >= deadline) return;
    const file = join(markerDir, relative(canonical, path));
    if (scope.skipReason(file) || !isCatchUpFile(markerDir, file)) continue;
    const entries = reviews.get(path) ?? [];
    const hash = entries.length > 0 ? fileContentHash(file) : null;
    let status: Coverage = "not-started";
    if (hash && isReviewed(entries, hash, contextHash, markerMtime, config)) status = "reviewed";
    else if (reviewPending(markerDir, file, config.timeoutMs)) status = "pending";
    else if (
      hash &&
      entries.some(
        (entry) =>
          entry.verdict &&
          FAILURE.has(entry.verdict) &&
          matchesReviewContent(entry, hash) &&
          currentEntry(entry, contextHash, markerMtime),
      )
    )
      status = "failed";
    yield { markerDir, file, status, timeoutMs: config.timeoutMs };
  }
}
