{
  "name": "@ask-llm/mcp",
  "version": "0.9.0",
  "mcpName": "io.github.Lykhoyda/ask-llm",
  "description": "Unified MCP server for multi-LLM consultation — routes Gemini, Codex, Claude, Grok, Ollama, and Antigravity behind runtime availability checks",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./machine": {
      "types": "./dist/machine.d.ts",
      "default": "./dist/machine.js"
    },
    "./cursor": {
      "types": "./dist/cursor.d.ts",
      "default": "./dist/cursor.js"
    }
  },
  "bin": {
    "ask-llm-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsdown",
    "start": "node dist/cli.js",
    "dev": "tsdown && node dist/cli.js",
    "test": "vitest run",
    "lint": "biome check src/ && tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "modelcontextprotocol",
    "llm",
    "multi-llm",
    "gemini",
    "codex",
    "openai",
    "google-gemini",
    "grok",
    "xai",
    "ollama",
    "antigravity",
    "agy",
    "local-llm",
    "claude",
    "ai",
    "ai-collaboration",
    "code-review",
    "second-opinion"
  ],
  "author": "Lykhoyda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lykhoyda/ask-llm.git",
    "directory": "packages/llm-mcp"
  },
  "bugs": {
    "url": "https://github.com/Lykhoyda/ask-llm/issues"
  },
  "homepage": "https://github.com/Lykhoyda/ask-llm#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@ask-llm/antigravity-mcp": "^0.7.3",
    "@ask-llm/claude-mcp": "^0.1.8",
    "@ask-llm/codex-mcp": "^0.7.6",
    "@ask-llm/gemini-mcp": "^1.8.0",
    "@ask-llm/grok-mcp": "^0.1.3",
    "@ask-llm/ollama-mcp": "^0.6.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@toon-format/toon": "^4.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ask-llm/shared": "workspace:*",
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^22.20.1",
    "ajv": "8.20.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
