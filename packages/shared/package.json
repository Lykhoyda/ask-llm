{
  "name": "@ask-llm/shared",
  "version": "0.6.1",
  "private": true,
  "description": "Shared utilities for @ask-llm/mcp: provider-agnostic registry, executor, change-mode parser, chunk cache, and diagnostics used by all Ask LLM providers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./logger": "./dist/logger.js",
    "./constants": "./dist/constants.js",
    "./command-executor": "./dist/commandExecutor.js",
    "./registry": "./dist/registry.js",
    "./change-mode": "./dist/changeMode/index.js",
    "./chunk-cache": "./dist/chunkCache.js",
    "./machine": "./dist/machine.js"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "lint": "biome check src/ && tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "ask-llm",
    "shared",
    "internal"
  ],
  "author": "Lykhoyda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lykhoyda/ask-llm.git",
    "directory": "packages/shared"
  },
  "bugs": {
    "url": "https://github.com/Lykhoyda/ask-llm/issues"
  },
  "homepage": "https://github.com/Lykhoyda/ask-llm#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/node": "^22.19.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
