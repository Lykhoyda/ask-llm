{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning --import ${CLAUDE_PLUGIN_ROOT}/scripts/strip-types.mjs ${CLAUDE_PLUGIN_ROOT}/scripts/codex-pair-stop-gate.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning --import ${CLAUDE_PLUGIN_ROOT}/scripts/strip-types.mjs ${CLAUDE_PLUGIN_ROOT}/scripts/codex-pair-watch.ts"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning --import ${CLAUDE_PLUGIN_ROOT}/scripts/strip-types.mjs ${CLAUDE_PLUGIN_ROOT}/scripts/codex-pair-session.ts"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning --import ${CLAUDE_PLUGIN_ROOT}/scripts/strip-types.mjs ${CLAUDE_PLUGIN_ROOT}/scripts/codex-pair-session.ts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --disable-warning=ExperimentalWarning --import ${CLAUDE_PLUGIN_ROOT}/scripts/strip-types.mjs ${CLAUDE_PLUGIN_ROOT}/scripts/codex-pair-prompt-drain.ts"
          }
        ]
      }
    ]
  }
}
