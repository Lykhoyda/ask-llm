{
  "name": "@ask-llm/plugin",
  "version": "0.19.5",
  "description": "Ask LLM review, comparison, brainstorming, image, verification, and pairing workflows for Claude Code, Cursor Agent, and Pi",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ask-antigravity-run": "dist/antigravity-run.js",
    "ask-brainstorm-run": "dist/brainstorm-run.js",
    "ask-codex-run": "dist/codex-run.js",
    "ask-gemini-run": "dist/run.js",
    "ask-grok-run": "dist/grok-run.js",
    "ask-ollama-run": "dist/ollama-run.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "biome check src/ pi/ && tsc --noEmit && tsc --noEmit -p pi/tsconfig.json"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "claude-code-plugin",
    "codex",
    "gemini",
    "grok",
    "xai",
    "ollama",
    "antigravity",
    "code-review",
    "second-opinion",
    "llm"
  ],
  "author": "Lykhoyda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lykhoyda/ask-llm.git",
    "directory": "packages/claude-plugin"
  },
  "bugs": {
    "url": "https://github.com/Lykhoyda/ask-llm/issues"
  },
  "homepage": "https://github.com/Lykhoyda/ask-llm#readme",
  "files": [
    "dist/",
    "pi/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ]
  },
  "dependencies": {
    "@ask-llm/mcp": "^1.2.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^24.13.6",
    "typebox": "1.3.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
