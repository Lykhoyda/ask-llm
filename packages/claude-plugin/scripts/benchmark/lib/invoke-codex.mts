// Source of truth: invoke-codex.mts. The sibling .mjs is generated by `yarn workspace @ask-llm/plugin build:hooks`; never edit it.

// Runs the real `codex exec --json` and parses the final agent message into the ADR-083 verdict shape.

import { spawn } from "node:child_process";

export interface CodexResult {
  agentMessage: string;
  usage: { input_tokens?: number; output_tokens?: number } | null;
  parsed: { findings?: unknown } | null;
}

export function invokeCodex({
  prompt,
  model = "gpt-5.5",
  timeoutMs = 300_000,
  codexBin = "codex",
}: {
  prompt: string;
  model?: string;
  timeoutMs?: number;
  codexBin?: string;
}): Promise<CodexResult> {
  return new Promise((resolve, reject) => {
    const child = spawn(
      codexBin,
      ["exec", "--json", "--sandbox=read-only", `--model=${model}`, "--ignore-user-config", "--ignore-rules"],
      { stdio: ["pipe", "pipe", "pipe"] },
    );

    let stdout = "";
    let stderr = "";
    let settled = false;

    // codex can ignore SIGTERM mid-turn (ADR-100), so a timeout needs SIGKILL plus explicit stdio teardown.
    const settleReject = (err: unknown) => {
      if (settled) return;
      settled = true;
      try {
        child.kill("SIGKILL");
      } catch {}
      try {
        child.stdout.destroy();
      } catch {}
      try {
        child.stderr.destroy();
      } catch {}
      try {
        child.stdin.destroy();
      } catch {}
      reject(err);
    };

    const settleResolve = (val: CodexResult) => {
      if (settled) return;
      settled = true;
      resolve(val);
    };

    const timer = setTimeout(() => {
      settleReject(
        new Error(
          `codex timed out after ${timeoutMs}ms (stdout=${stdout.length}B, stderr=${stderr.length}B captured before SIGKILL)`,
        ),
      );
    }, timeoutMs);

    child.stdout.on("data", (c: Buffer) => {
      stdout += c.toString();
    });
    child.stderr.on("data", (c: Buffer) => {
      stderr += c.toString();
    });
    child.on("close", (code) => {
      clearTimeout(timer);
      if (settled) return;
      if (code !== 0) {
        settleReject(new Error(`codex exited ${code}: ${stderr.slice(0, 500)}`));
        return;
      }
      try {
        settleResolve(parseCodexJsonl(stdout));
      } catch (err) {
        settleReject(err);
      }
    });
    child.on("error", (err) => {
      clearTimeout(timer);
      settleReject(err);
    });
    child.stdin.write(prompt);
    child.stdin.end();
  });
}

function parseCodexJsonl(stdout: string): CodexResult {
  const lines = stdout.split("\n").filter((l) => l.trim().length > 0);
  let agentMessage: string | null = null;
  let usage: CodexResult["usage"] = null;
  for (const line of lines) {
    let event: {
      type?: string;
      item?: { type?: string; text?: string };
      usage?: CodexResult["usage"];
    } | null;
    try {
      event = JSON.parse(line);
    } catch {
      continue;
    }
    if (event?.type === "item.completed" && event.item?.type === "agent_message") {
      agentMessage = event.item.text as string;
    } else if (event?.type === "turn.completed") {
      usage = event.usage ?? null;
    }
  }
  if (!agentMessage) throw new Error("no agent_message in codex output");
  return { agentMessage, usage, parsed: tryParseVerdict(agentMessage) };
}

function tryParseVerdict(text: string): CodexResult["parsed"] {
  const trimmed = text.trim();
  const fenced = trimmed.match(/^```(?:json)?\s*\n([\s\S]*?)\n```\s*$/i);
  const candidate = fenced ? fenced[1] : trimmed;
  try {
    return JSON.parse(candidate);
  } catch {
    return null;
  }
}
