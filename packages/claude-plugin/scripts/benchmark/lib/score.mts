// Source of truth: score.mts. The sibling .mjs is generated by `yarn workspace @ask-llm/plugin build:hooks`; never edit it.

// ponytail: keyword matching, not an LLM judge; switch to a judge when probe recall needs better signal.

export interface Finding {
  severity?: string;
  title?: string;
  file?: string;
  line_start?: number;
  body?: string;
  recommendation?: string;
}

export interface Probe {
  id: string;
  description: string;
  severity_expected: string;
  keywords?: string[];
}

export interface Probes {
  category: string;
  task_description: string;
  should_flag: Probe[];
}

export interface Score {
  caught: { probe: Probe; finding: Finding }[];
  missed: { probe: Probe }[];
  extra: Finding[];
  recall: number;
  findings_total: number;
}

const KEYWORD_MATCH_THRESHOLD = 2; // ≥2 keywords must appear in the finding text

export function score({ verdict, probes }: { verdict: { findings?: unknown } | null; probes: Probes }): Score {
  const findings: Finding[] = Array.isArray(verdict?.findings) ? verdict.findings : [];
  const caught: Score["caught"] = [];
  const missed: Score["missed"] = [];

  for (const probe of probes.should_flag) {
    const match = findings.find((f) => probeMatchesFinding(probe, f));
    if (match) {
      caught.push({ probe, finding: match });
    } else {
      missed.push({ probe });
    }
  }

  // Unmatched findings are surfaced as "extra" for human judgment.
  const matchedFindingIds = new Set(caught.map((c) => findingId(c.finding)));
  const extra = findings.filter((f) => !matchedFindingIds.has(findingId(f)));

  return {
    caught,
    missed,
    extra,
    recall: probes.should_flag.length > 0 ? caught.length / probes.should_flag.length : 1,
    findings_total: findings.length,
  };
}

function probeMatchesFinding(probe: Probe, finding: Finding): boolean {
  const haystack = [finding.title ?? "", finding.body ?? "", finding.recommendation ?? ""].join(" ").toLowerCase();
  let hits = 0;
  for (const kw of probe.keywords ?? []) {
    if (haystack.includes(kw.toLowerCase())) hits++;
    if (hits >= KEYWORD_MATCH_THRESHOLD) return true;
  }
  return hits >= KEYWORD_MATCH_THRESHOLD;
}

function findingId(finding: Finding): string {
  return `${finding.file ?? ""}:${finding.line_start ?? 0}:${(finding.title ?? "").slice(0, 40)}`;
}
