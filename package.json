{
  "name": "ask-llm",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/docs"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A --topological-dev run build",
    "test": "vitest run",
    "test:batch": "node scripts/run-test-batch.mjs",
    "lint": "node scripts/check-workflow-security.mjs && node scripts/check-docs-drift.mjs && node scripts/sync-plugin-manifests.mjs --check && biome lint scripts/ apps/docs/.vitepress/ && tsc --noEmit -p scripts/tsconfig.json && yarn workspaces foreach -A run lint",
    "smoke": "node scripts/harness-smoke.mjs --dry-run",
    "smoke:harness": "node scripts/harness-smoke.mjs --dry-run",
    "prepr:harness": "bash scripts/pre-pr-harness-smoke.sh",
    "docs:dev": "yarn workspace docs run dev",
    "docs:build": "yarn workspace docs run build",
    "docs:preview": "yarn workspace docs run preview",
    "benchmark": "yarn build && npx tsx scripts/benchmark-overhead.ts",
    "benchmark:toon-doctor": "tsx scripts/benchmark-toon-doctor.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version && yarn install --mode=update-lockfile && node scripts/sync-plugin-manifests.mjs",
    "changeset:status": "changeset status --verbose",
    "changeset:publish": "yarn build && changeset publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.19.13",
    "husky": "^9.1.7",
    "js-tiktoken": "^1.0.21",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@4.18.0"
}
